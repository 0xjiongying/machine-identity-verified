# Cleanverse Cooperate API (server-side only — never prefix with VITE_)
# Docs: https://docs.cleanverse.com  (API v5.6)
# Copy to .env.local and fill values from your hackathon welcome email.

CLEANVERSE_API_URL=https://uatapi.cleanverse.com/api/cooperate
CLEANVERSE_SANDBOX_API_ID=
CLEANVERSE_SANDBOX_API_KEY=
CLEANVERSE_CHAIN=monad
# Origin token symbol for POST /query_deposit_atoken_list (docs: not an A-Token symbol)
CLEANVERSE_ORIGIN_SYMBOL=usdc
# Preferred A-Token symbol selected from the returned list
CLEANVERSE_ATOKEN_SYMBOL=ausdc
