# Machine Trust — environment placeholders only (never commit real secrets).
# Copy to .env.local for local development. On Render, set these in the dashboard / render.yaml sync:false.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Public site URL (used for docs / future CORS allowlist). Same-origin monolith does not require browser CORS for server functions.
FRONTEND_URL=https://your-service.onrender.com

# Optional: absolute public origin of this app (rarely needed — TanStack Start server functions are same-origin).
# API_BASE_URL=https://your-service.onrender.com

# ── Cleanverse Cooperate API (server-side ONLY — never VITE_*) ───────────────
# Docs: https://docs.cleanverse.com  (API v5.6)
CLEANVERSE_API_URL=https://uatapi.cleanverse.com/api/cooperate
CLEANVERSE_SANDBOX_API_ID=
CLEANVERSE_SANDBOX_API_KEY=
CLEANVERSE_CHAIN=monad
CLEANVERSE_ORIGIN_SYMBOL=usdc
CLEANVERSE_ATOKEN_SYMBOL=ausdc

# Docs unlock for local tooling only (never required at runtime on Render)
# CLEANVERSE_DOCS_INVITATION_CODE=

# ── Monad Testnet / MachineTrustRegistry (server-side ONLY — never VITE_*) ───
# Official Testnet: https://docs.monad.xyz/developer-essentials/testnet
# chain id 10143 · RPC https://testnet-rpc.monad.xyz · explorer https://testnet.monadvision.com
# Leave unset to keep DEMO settlement references after CCP approval.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_NETWORK_LABEL=monad-testnet
MONAD_TESTNET_PRIVATE_KEY=
# Deployed MachineTrustRegistry on Monad Testnet (public address — also in contracts/deployments/monad-testnet.json)
MACHINETRUST_REGISTRY_ADDRESS=0x83753166684AfB4912a61713c49Feada6298dF19
# Constructor operator for explicit `npm run registry:deploy` / oracle for MachineTrustCredit
# MACHINETRUST_OPERATOR_ADDRESS=
# Track 2 CVI-gated DeFi credit deposit (set after `npm run credit:deploy`)
# MACHINE_TRUST_CREDIT_ADDRESS=

# ── Database ─────────────────────────────────────────────────────────────────
# Not required by the current Track 1 build (state is in-memory / client presentation).
# DATABASE_URL=

# Nitro target override (default in npm run build: node-server)
# NITRO_PRESET=node-server
